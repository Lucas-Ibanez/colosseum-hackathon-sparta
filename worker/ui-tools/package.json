{
  "name": "vericode-ui-tools",
  "private": true,
  "description": "Ferramentas de desenvolvimento da interface Hive: lint do DESIGN.md, ícones e capturas. Nada daqui é servido pelo worker nem roda no caminho do MVP.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint:design": "design.md lint ../../DESIGN.md",
    "gen:tokens": "node gen-tokens.mjs",
    "check:tokens": "node gen-tokens.mjs --check",
    "sync:assets": "node sync-assets.mjs",
    "check:assets": "node sync-assets.mjs --check",
    "capture": "node capture.mjs"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "lucide-static": "1.52.0",
    "playwright": "1.63.0"
  }
}
